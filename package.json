{
  "name": "browser-toolkit",
  "version": "0.2.2",
  "description": "個人用のツールキット Chrome拡張機能（テーブルソート、AI連携など）",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "dist/background.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run typecheck && pnpm run bundle && pnpm run copy:styles",
    "build-storybook": "storybook build",
    "bundle": "node scripts/bundle.mjs",
    "clean": "node scripts/clean.mjs",
    "copy:styles": "node scripts/copy-styles.mjs",
    "dev": "node scripts/dev-server.mjs",
    "doctor": "ultracite doctor",
    "format": "ultracite fix",
    "hooks:install": "lefthook install",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --project=node --project=dom --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:storybook": "vitest run --project=storybook",
    "test:unit:dom": "vitest run --project=dom --maxWorkers=1",
    "test:unit:node": "vitest run --project=node --maxWorkers=1",
    "test:visual": "test-storybook",
    "test:visual:update": "test-storybook --updateSnapshot",
    "test:watch": "vitest --project=node --project=dom --maxWorkers=1",
    "test-storybook": "pnpm run test:storybook",
    "typecheck": "tsc --noEmit",
    "watch": "node scripts/bundle.mjs --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@praha/byethrow": "^0.12.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "encoding-japanese": "^2.2.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@chromatic-com/storybook": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@storybook/test-runner": "^0.24.4",
    "@types/chrome": "^0.2.5",
    "@types/encoding-japanese": "^2.2.1",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/jsdom": "^28.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "jest-image-snapshot": "^6.5.2",
    "jsdom": "^30.0.1",
    "lefthook": "2.1.10",
    "playwright": "^1.62.1",
    "storybook": "^10.5.7",
    "typescript": "^7.0.2",
    "ultracite": "7.10.1",
    "vitest": "^4.1.10",
    "ws": "^8.21.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
